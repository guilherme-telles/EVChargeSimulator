{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Development (Debug, tests + desktop if Qt is found)",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "EV_BUILD_TESTS": "ON",
        "EV_BUILD_DESKTOP": "ON"
      }
    },
    {
      "name": "core",
      "displayName": "Core libraries + tests only (no Qt)",
      "inherits": "dev",
      "cacheVariables": { "EV_BUILD_DESKTOP": "OFF" }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "dev",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "coverage",
      "displayName": "Coverage (GCC/Clang, core only)",
      "inherits": "core",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "--coverage -O0",
        "CMAKE_EXE_LINKER_FLAGS": "--coverage"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev", "configuration": "Debug" },
    { "name": "core", "configurePreset": "core", "configuration": "Debug" },
    { "name": "release", "configurePreset": "release", "configuration": "Release" },
    { "name": "coverage", "configurePreset": "coverage", "configuration": "Debug" }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "core",
      "configurePreset": "core",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "coverage",
      "configurePreset": "coverage",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    }
  ]
}
